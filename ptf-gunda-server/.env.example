# ---- Pass to the Floor · Gunda · Server Edition: settings --------------------------------------------------------------
# In Azure these are App Service settings; the secrets are Key Vault references (see docs/DEPLOYMENT-AZURE.md). Never commit a real .env.

PTF_ENV=production
PTF_PUBLIC_URL=https://ptf.your-company.com          # the address people open, https only
PTF_TZ=Europe/London                                  # time zone for "07:00 daily project e-mail" and dates

# Database (Azure Database for PostgreSQL Flexible Server, private access only)
DATABASE_URL=postgres://ptfapp:PASSWORD@your-server.postgres.database.azure.com:5432/ptf?sslmode=require
DATABASE_SSL=true

# Secrets: long random values, e.g.  openssl rand -base64 48
PTF_SALT=
PTF_SESSION_SECRET=
PTF_SESSION_HOURS=10                                  # a session never lasts longer than this
PTF_SESSION_IDLE_MIN=120                              # and ends after this long without use

# Microsoft Entra ID (the app registration; client secret from Key Vault)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_ADMIN_ROLE=PTF.Admin                            # app role that makes a person a tool administrator
PTF_ALLOWED_DOMAINS=your-company.com                  # only these e-mail domains may sign in
PTF_BOOTSTRAP_ADMINS=                                 # optional: first admin e-mails before app roles exist, then empty this

# E-mail (Microsoft Graph, application permission Mail.Send limited to one mailbox)
PTF_MAIL=graph
PTF_MAIL_FROM=ptf-noreply@your-company.com

# Files (evaluation videos, project attachments): an Azure Files share mounted here
PTF_DATA_DIR=/mnt/ptf-files

# Behind Azure Front Door: only accept traffic that carries your Front Door's id
PTF_TRUST_PROXY=true
PTF_FRONTDOOR_ID=

# Optional
# PTF_RPC_PER_MIN=600          requests per person per minute
# PTF_METRICS=fast             log a metrics line every 5 s instead of every minute
# APPLICATIONINSIGHTS_CONNECTION_STRING=
