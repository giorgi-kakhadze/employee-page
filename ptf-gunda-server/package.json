{
  "name": "ptf-gunda-server",
  "version": "4.1.0",
  "description": "Pass to the Floor \u00b7 Gunda \u00b7 Server Edition: the same tool, hosted centrally, signed in with Microsoft Entra ID, data in PostgreSQL.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.5"
  },
  "main": "src/server.js",
  "scripts": {
    "build:rules": "node tools/port-code-gs.js",
    "build:client": "node client/build.js",
    "build": "npm run build:rules && npm run build:client",
    "start": "node src/server.js",
    "dev": "PTF_ENV=dev node src/server.js",
    "test": "node test/run-all.js",
    "loadtest": "node loadtest/run.js",
    "test:parity": "node test/run-parity.js"
  },
  "dependencies": {},
  "optionalDependencies": {
    "pg": "8.13.1"
  }
}